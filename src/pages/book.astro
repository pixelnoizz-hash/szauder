    <section class="book-sec">
      <h2 class="sec-h rv">Series in the book</h2>
      <ul class="series-list rv">
        {series.map(([n, y]) => (
          <li><span class="s-name">{n}</span><span class="s-year">{y}</span></li>
        ))}
      </ul>
    </section>

    <section class="book-sec">
      <h2 class="sec-h rv">Details</h2>
      <dl class="book-facts rv">
        {facts.map(([k, v]) => (
          <div class="bfact"><dt>{k}</dt><dd>{v}</dd></div>
        ))}
      </dl>
    </section>
  </article>
</Base>

<style is:global>
.bookpage{padding:clamp(110px,15vh,180px) 0 clamp(60px,9vw,120px)}
.book-top{display:grid;grid-template-columns:1fr 1fr;gap:clamp(32px,5vw,80px);align-items:start;margin-bottom:clamp(52px,7vw,100px)}
.bookpage .tag{display:block;margin-bottom:14px}
.bookpage h1{font-family:var(--serif);font-size:clamp(2.6rem,7vw,5.2rem);line-height:.94;margin:0;font-weight:400}
.bookpage .sub{font-family:var(--mono);font-size:.66rem;letter-spacing:.16em;text-transform:uppercase;color:var(--dust);margin:18px 0 0;line-height:1.7}
.own-quote{margin:clamp(28px,3.6vw,44px) 0 0;padding-left:20px;border-left:1px solid var(--ember);
  font-family:var(--serif);font-style:italic;font-size:clamp(1.15rem,2vw,1.5rem);line-height:1.35;max-width:32ch}
.own-quote cite{display:block;margin-top:12px;font-family:var(--mono);font-style:normal;font-size:.6rem;
  letter-spacing:.18em;text-transform:uppercase;color:var(--dust)}
.bookpage .body{color:var(--dust);line-height:1.7;margin:clamp(26px,3.2vw,40px) 0 0;max-width:46ch;font-size:1.02rem}
.order{margin-top:clamp(30px,3.8vw,46px)}
.order-label{font-family:var(--mono);font-size:.6rem;letter-spacing:.18em;text-transform:uppercase;color:var(--dust);display:block;margin-bottom:14px}
.order-btns{display:flex;gap:10px;flex-wrap:wrap}
.order-btns .btn{margin-top:0;padding:13px 26px}
.order-note{font-family:var(--mono);font-size:.56rem;letter-spacing:.13em;text-transform:uppercase;color:var(--dust);margin:16px 0 0}
.book-shots{display:grid;gap:clamp(12px,1.6vw,22px)}
.book-shots .aperture img{width:100%}
.book-sec{margin-bottom:clamp(46px,6vw,86px)}
.sec-h{font-family:var(--serif);font-size:clamp(1.5rem,3vw,2.2rem);font-weight:400;margin:0 0 26px;line-height:1}
.series-list{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,1fr);
  gap:0 clamp(20px,3vw,50px);border-top:1px solid var(--hair)}
.series-list li{display:flex;justify-content:space-between;align-items:baseline;gap:14px;
  padding:12px 0;border-bottom:1px solid var(--hair)}
.s-name{font-family:var(--serif);font-size:1.02rem}
.s-year{font-family:var(--mono);font-size:.58rem;letter-spacing:.13em;color:var(--dust)}
.book-facts{margin:0;border-top:1px solid var(--hair)}
.bfact{display:grid;grid-template-columns:clamp(110px,15vw,190px) minmax(0,1fr);gap:clamp(14px,2vw,30px);
  padding:14px 0;border-bottom:1px solid var(--hair)}
.bfact dt{font-family:var(--mono);font-size:.58rem;letter-spacing:.16em;text-transform:uppercase;color:var(--dust)}
.bfact dd{margin:0;font-size:.95rem;line-height:1.5}
@media (max-width:900px){
  .book-top{grid-template-columns:1fr;gap:36px}
  .book-shots{order:-1;max-width:520px}
  .series-list{grid-template-columns:repeat(2,1fr)}
}
@media (max-width:600px){
  .series-list{grid-template-columns:1fr}
  .bfact{grid-template-columns:1fr;row-gap:5px}
}
</style>
