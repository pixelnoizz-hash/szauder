---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';

import cover from '../assets/works/glitches-cover.jpg';
import spread from '../assets/works/glitches-spread.jpg';

const facts = [
  ['Title', 'Glitches & Glory — The Digitally Rewired Art of David Szauder'],
  ['Publisher', 'gestalten, Berlin'],
  ['Year', '2025, first printing'],
  ['Extent', '256 pages'],
  ['ISBN', '978-3-96704-204-7'],
  ['Images', 'David Szauder'],
  ['Texts', 'Scott Minneman'],
  ['Prefaces', 'Lynn Goldsmith · Jean-Michel Jarre'],
  ['Afterword', 'David Szauder'],
  ['Edited by', 'François-Luc Giraldeau, David Szauder, Anna Réka Baktay'],
  ['Design', 'Benjamin Wolbergs'],
  ['Typefaces', 'Rauschen B (Philipp Herrmann) · Aether (Dominik Thieme)'],
  ['Printing', 'aprinta druck, Germany — FSC certified paper'],
];

const series = [
  ['Confidence', '2024'], ['Bestiarium', '2023'], ['Folkloric Robots', '2024'],
  ['Art of Hiding', '2023'], ['Hypnosis', '2024'], ["New Year's Swing", '2024'],
  ['Anatomy Sweaters', '2024'], ['Sweet Dreams', '2024'], ['Heroism', '2024'],
  ['Swan Lake', '2024'], ['Memento Mori', '2024'], ['Super Ladies', '2024'],
  ['Angels and Demons', '2024'], ['Food Memories', '2024'], ['Innocent Game', '2024'],
  ['Perfect Day', '2024'], ['The Peaceful Era', '2024'], ['Waltzer', '2024'],
  ['Faith', '2025'], ['Catsy', '2025'], ['Irrational Harmonies', '2023'],
  ['Gender Issues', '2023'], ['Improvisation', '2023'], ['Generative Paintings', '2023'],
  ['Transhumanism', '2022'], ['Explosions', '2022'], ['Mondrian Study', '2022'],
  ['Failed Memories', '2013'],
];
---

<Base title="Glitches & Glory — David Szauder"
