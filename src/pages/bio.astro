---
import Base from '../layouts/Base.astro';

const facts: [string, string | string[]][] = [
  ['Selected exhibitions & projects — 2026', [
    'Triptych: Memory, Doubt and Fates — St. Benoît Church, 212 Photography Istanbul, with Anna Réka Baktay',
    'Festival dei Due Mondi — Spoleto, large-scale architectural projections',
    'Wunderland — Hamburg Ballet, costume design; choreography by Alexei Ratmansky',
    'György Kurtág: Kafka-Fragmente — Sejong Soloists / Karole Armitage, Seoul',
  ]],
  ['Selected exhibitions & projects — 2025', 'Glitches & Glory — Elza Kayal Gallery, Tribeca, New York'],
  ['Monograph', 'Glitches & Glory — Gestalten, 2025'],
  ['Selected editorial commissions', [
    'WIRED Italia — cover',
    'The New Yorker — illustrations',
    'The Washington Post Magazine — cover illustration, 2022',
  ]],
  ['Selected press', 'WIRED Italia · Whitehot Magazine · Kurier'],
  ['Selected collaborations', 'Hamburg Ballet · Festival dei Due Mondi, Spoleto · Sejong Soloists · Karole Armitage · Jean-Michel Jarre · Duran Duran · Ars Electronica'],
  ['Speaking', ['TED Next, 2025', 'Liszt Institute Seoul, 2026']],
  ['Teaching', 'Founder and course leader, AI Storytelling — Moholy-Nagy University of Art and Design, 2023—2025'],
  ['Awards', [
    'British Creative Cover of the Year — The Washington Post Magazine, 2022',
    'EDIDA Award — Spheres, 2025',
  ]],
  ['Published by', 'Oxford University Press'],
  ['Education', 'MA Intermedia, Hungarian University of Fine Arts'],
];
---

<Base title="Bio — David Szauder" description="David Szauder is a visual artist based in Vienna and Budapest, working across visual art, moving image, stage and costume design.">
  <article class="wrap bio">
    <header class="rv">
      <span class="tag">Bio</span>
      <h1>David Szauder</h1>
    </header>

    <div class="bio-grid">
      <div class="bio-text rv">
        <p class="lead">Born in Budapest in 1976, based in Vienna and Budapest. David Szauder works
          across visual art, moving image, stage and costume design, combining computational and
          traditional image-making to explore authorship, memory, perception and the unstable
          relationship between human- and machine-made images.</p>

        <p>He develops his visual language through self-built systems and personal archives rather
          than generic image databases. His source material has included Hungarian newspaper
          clippings from the 1980s, Burda pattern sheets, technical manuals and family documents.
          Generated imagery becomes one part of a broader process of deconstruction, recomposition
          and visual storytelling.</p>

        <p>In 2025 his solo exhibition <em>Glitches &amp; Glory</em> opened at Elza Kayal Gallery in
          New York, alongside the monograph of the same name published by Gestalten. The same year he
          spoke at TED Next on the cultural implications of artificial intelligence.</p>

        <p>In 2026 his practice expanded into performance, stage and large-scale spatial work. He
          designed around sixty costumes for Alexei Ratmansky's <em>Wunderland</em> at Hamburg Ballet
          and created a series of large-scale architectural projections for the Festival dei Due Mondi
          in Spoleto. In Seoul he collaborated with Sejong Soloists and choreographer Karole Armitage on
          György Kurtág's <em>Kafka-Fragmente</em>.</p>

        <p>Also in 2026, together with Anna Réka Baktay, he presented <em>Triptych: Memory, Doubt and
          Fates</em> at St. Benoît Church as part of 212 Photography Istanbul. The exhibition brought
          together early works based on error and forgetting, the <em>Doppelgänger</em> series
          and the <em>Folkloric Robots</em> project.</p>

        <p>His editorial work includes a cover for WIRED Italia, illustrations for The New Yorker and
          the 2022 cover of The Washington Post Magazine, which received the British Creative Cover of
          the Year award. His <em>Spheres</em> wallpaper collection received an EDIDA Award in 2025.</p>

        <p>He has created visual work for Jean-Michel Jarre and Duran Duran, has collaborated with Ars
          Electronica since 2023, and his work has been published by Oxford University Press. In 2023
          he founded the first AI Storytelling Course at Moholy-Nagy University of Art and Design in
          Budapest, which he led until 2025.</p>

        <p>He holds an MA in Intermedia from the Hungarian University of Fine Arts.</p>
      </div>

      <dl class="bio-facts rv">
        {facts.map(([k, v]) => (
          <div class="fact"><dt>{k}</dt><dd>{Array.isArray(v) ? v.map((x) => <span class="fi">{x}</span>) : v}</dd></div>
        ))}
      </dl>
    </div>
  </article>
</Base>

<style is:global>
.bio{padding:clamp(110px,15vh,180px) 0 clamp(60px,9vw,120px)}
.bio .tag{display:block;margin-bottom:14px}
.bio h1{font-family:var(--serif);font-size:clamp(2.4rem,6.5vw,5rem);line-height:.98;margin:0 0 clamp(38px,5vw,64px);font-weight:400}
.bio-grid{display:grid;grid-template-columns:1.25fr .75fr;gap:clamp(32px,5vw,80px);align-items:start}
.bio-text{font-size:1.02rem;line-height:1.75;color:var(--dust);max-width:62ch}
.bio-text p{margin:0 0 1.3em}
.bio-text .lead{font-family:var(--serif);font-style:italic;font-size:clamp(1.15rem,2vw,1.5rem);
  line-height:1.45;color:var(--bone);margin-bottom:1.6em}
.bio-text em{font-style:italic;color:var(--bone)}
.bio-facts{margin:0;border-top:1px solid var(--hair)}
.fact{padding:15px 0;border-bottom:1px solid var(--hair)}
.fact dt{font-family:var(--mono);font-size:.58rem;letter-spacing:.17em;text-transform:uppercase;color:var(--dust);margin-bottom:7px}
.fact dd{margin:0;font-size:.95rem;line-height:1.5}
.fact .fi{display:block}
.fact .fi + .fi{margin-top:6px}
@media (max-width:900px){ .bio-grid{grid-template-columns:1fr;gap:36px} }
</style>
