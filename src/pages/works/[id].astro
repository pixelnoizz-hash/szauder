---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const works = await getCollection('works');
  return works.map((w) => ({ params: { id: w.id }, props: { work: w } }));
}

const { work } = Astro.props;
const d = work.data;
const { Content } = await render(work);
const all = (await getCollection('works')).sort((a, b) => a.data.order - b.data.order);
const idx = all.findIndex((w) => w.id === work.id);
const next = all[(idx + 1) % all.length];
const images = [d.cover, ...d.gallery];
---

<Base title={`${d.title} — David Szauder`} description={d.note} ogImage={d.cover}>
  <article class="wrap project">
    <header class="proj-head rv">
      <span class="tag">{d.tag}</span>
      <h1>{d.title}</h1>
      <p class="proj-note">{d.note}</p>
      {d.from && <p class="from">{d.from}</p>}
      <dl class="specs">
        <div class="spec"><dt>Role</dt><dd>{d.role}</dd></div>
        <div class="spec"><dt>Where</dt><dd>{d.where}</dd></div>
        <div class="spec"><dt>Year</dt><dd>{d.year}</dd></div>
      </dl>
    </header>

    <div class="proj-body"><Content /></div>

    <div class="plates">
      {images.map((img: any, i: number) => (
        <figure class={`plate rv ${i % 3 === 0 ? 'wide' : ''}`}>
          <span class="aperture">
            <Image src={img} alt={`${d.title}, image ${i + 1}`} widths={[700, 1100, 1600]}
                   sizes="(max-width: 900px) 92vw, 78vw" />
          </span>
        </figure>
      ))}
    </div>

    {d.photoCredit && <p class="photo-credit">{d.photoCredit}</p>}

    {d.press.length > 0 && (
      <section class="press-block rv">
        <span class="tag">Press</span>
        <ul>
          {d.press.map((p: any) => (
            <li>
              <a href={p.url} target="_blank" rel="noopener">
                <span class="p-outlet">{p.outlet}</span>
                <span class="p-title">{p.title}</span>
                <span class="p-arrow">&nearr;</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <nav class="proj-next rv">
      <a href={`/works/${next.id}`}>
        <span class="tag">Next work</span>
        <span class="next-title">{next.data.title} &rarr;</span>
      </a>
      <a href="/" class="back">&larr; All works</a>
    </nav>
  </article>
</Base>

<style is:global>
.project{padding:clamp(110px,15vh,180px) 0 clamp(60px,9vw,120px)}
.proj-head{max-width:62ch;margin-bottom:clamp(38px,5vw,68px)}
.proj-head .tag{display:block;margin-bottom:16px}
.proj-head h1{font-family:var(--serif);font-size:clamp(2.4rem,6.5vw,5rem);line-height:.98;margin:0;font-weight:400}
.proj-note{font-family:var(--serif);font-style:italic;font-size:clamp(1.1rem,2vw,1.5rem);line-height:1.4;margin:22px 0 0;max-width:36ch}
.proj-body{max-width:60ch;color:var(--dust);line-height:1.7;margin-bottom:clamp(30px,4vw,54px)}
.proj-body p{margin:0 0 1.1em}
.plates{display:grid;gap:clamp(14px,2vw,30px)}
.plate{margin:0}
.plate .aperture img{aspect-ratio:3/2}
.plate.wide{grid-column:1/-1}
.press-block{margin-top:clamp(44px,6vw,80px)}
.press-block .tag{display:block;margin-bottom:18px}
.press-block ul{list-style:none;margin:0;padding:0;border-top:1px solid var(--hair)}
.press-block li{border-bottom:1px solid var(--hair)}
.press-block a{display:grid;grid-template-columns:clamp(110px,14vw,170px) minmax(0,1fr) auto;
  gap:clamp(12px,2vw,26px);align-items:baseline;padding:15px 0;transition:padding-left .3s ease}
.press-block a:hover{padding-left:10px}
.p-outlet{font-family:var(--mono);font-size:.6rem;letter-spacing:.15em;text-transform:uppercase;color:var(--ember)}
.p-title{font-family:var(--serif);font-size:1.02rem;line-height:1.35}
.p-arrow{color:var(--dust);font-size:.9rem}
@media (max-width:700px){ .press-block a{grid-template-columns:1fr auto;row-gap:5px}
  .p-outlet{grid-column:1/-1} }
.proj-next{margin-top:clamp(50px,7vw,90px);padding-top:26px;border-top:1px solid var(--hair);
  display:flex;justify-content:space-between;align-items:flex-end;gap:20px;flex-wrap:wrap}
.proj-next .tag{display:block;margin-bottom:8px}
.next-title{font-family:var(--serif);font-size:clamp(1.4rem,3vw,2.2rem);line-height:1}
.proj-next .back{font-family:var(--mono);font-size:.65rem;letter-spacing:.18em;text-transform:uppercase;color:var(--dust)}
.proj-next .back:hover{color:var(--bone)}
@media (min-width:900px){ .plates{grid-template-columns:1fr 1fr} }
</style>
