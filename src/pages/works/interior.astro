---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';

import sphHydro from '../../assets/interior/sph-hydro.jpg';
import sphBio from '../../assets/interior/sph-bio.jpg';
import sphAtmo from '../../assets/interior/sph-atmo.jpg';
import edida from '../../assets/interior/edida.jpg';
import leonHero from '../../assets/interior/leon-hero.jpg';
import leon2 from '../../assets/interior/leon-2.jpg';
import leon3 from '../../assets/interior/leon-3.jpg';
import leon4 from '../../assets/interior/leon-4.jpg';
import leon5 from '../../assets/interior/leon-5.jpg';
import dctHero from '../../assets/interior/dct-hero.jpg';
import dctWall from '../../assets/interior/dct-wall.jpg';
import dct1 from '../../assets/interior/dct-1.jpg';
import dct2 from '../../assets/interior/dct-2.jpg';

const spheres = ['Hydrosphere', 'Atmosphere', 'Biosphere', 'Lithosphere', 'Thermosphere'];
---

<Base title="Interior — David Szauder"
      description="Artworks for the Leon Hotel Budapest, the Spheres wallpaper with Freeform and Tecnografica, and the Dream Come True installation at S/ALON Budapest."
      ogImage={leonHero}>
  <article class="wrap interior">
    <header class="rv">
      <span class="tag">Applied</span>
      <h1>Interior</h1>
      <p class="in-lead">Work that stops being an image and becomes a surface — a wall, a room,
        a building people move through without deciding to look.</p>
    </header>

    <!-- LEON HOTEL -->
    <section class="in-item rv">
      <div class="in-head">
        <h2>Leon Hotel</h2>
        <span class="in-kind">Artworks — Budapest</span>
      </div>

      <figure class="in-hero">
        <span class="aperture">
          <Image src={leonHero} alt="Hotel lounge with framed portraits of figures in ornate headdresses on the walls"
                 widths={[900, 1400, 1600]} sizes="(max-width: 900px) 94vw, 84vw" />
        </span>
      </figure>

      <div class="in-body">
        <div class="in-text">
          <p>A body of framed works running through the public spaces of a Budapest hotel —
            reception, lounge, bar and the rooms. Figures in impossible headdresses, crowns built
            like architecture, faces that look like carved stone.</p>
          <p>A hotel is a place people pass through half-attentively, at odd hours, often alone.
            The works are hung to be met that way: noticed on the second glance rather than the first.</p>
        </div>

        <dl class="in-specs">
          <div><dt>Role</dt><dd>Artist — works throughout the hotel</dd></div>
          <div><dt>Where</dt><dd>Leon Hotel, Budapest</dd></div>
          <div><dt>Scope</dt><dd>Reception, lounge, bar, guest rooms</dd></div>
        </dl>
      </div>

      <div class="in-grid two">
        <span class="aperture"><Image src={leon2} alt="Hotel reception with a framed portrait and a sculptural crown work" widths={[500, 1000]} sizes="(max-width: 900px) 94vw, 42vw" /></span>
        <span class="aperture"><Image src={leon3} alt="Lounge with two large framed portraits under ring lights" widths={[500, 1000]} sizes="(max-width: 900px) 94vw, 42vw" /></span>
      </div>
      <div class="in-grid two">
        <span class="aperture"><Image src={leon4} alt="Hotel bar with a round work showing a crowned figure in profile" widths={[500, 1000]} sizes="(max-width: 900px) 94vw, 42vw" /></span>
        <span class="aperture"><Image src={leon5} alt="Guest room with a large framed work above the bed" widths={[500, 1000]} sizes="(max-width: 900px) 94vw, 42vw" /></span>
      </div>

      <ul class="in-press">
        <li><a href="https://leonhotelbudapest.hu/en/" target="_blank" rel="noopener"><span class="p-outlet">Leon Hotel</span><span class="p-title">Leon Hotel Budapest</span><span class="p-arrow">&nearr;</span></a></li>
      </ul>
    </section>

    <!-- SPHERES -->
    <section class="in-item rv">
      <div class="in-head">
        <h2>Spheres</h2>
        <span class="in-kind">Wallpaper — Freeform &amp; Szauder</span>
      </div>

      <figure class="in-hero">
        <span class="aperture">
          <Image src={sphHydro} alt="A room whose curved walls are covered by an underwater world of corals, jellyfish and lamps"
                 widths={[700, 1100]} sizes="(max-width: 900px) 94vw, 84vw" />
        </span>
        <figcaption>Hydrosphere</figcaption>
      </figure>

      <div class="in-body">
        <div class="in-text">
          <p>Five wallcoverings made with the interior design studio <strong>Freeform</strong> and
            produced by <strong>Tecnografica</strong> in Italy. Each one takes a layer of the planet
            and rebuilds it as somewhere that does not exist: hydrosphere, atmosphere, biosphere,
            lithosphere, thermosphere.</p>
          <p>The design problem is perspective. On a wall of this size a flat pattern stays flat, but
            a constructed depth makes the room read as larger than it is. That is what these are for
            — they are less decoration than an opening in the wall.</p>
          <p class="in-award">EDIDA Award, 2025 — Elle Deco International Design Awards</p>
        </div>

        <dl class="in-specs">
          <div><dt>Role</dt><dd>Artist — image design</dd></div>
          <div><dt>With</dt><dd>Freeform, interior design studio</dd></div>
          <div><dt>Produced by</dt><dd>Tecnografica, Italy</dd></div>
          <div><dt>Series</dt><dd>{spheres.join(' · ')}</dd></div>
          <div><dt>Use</dt><dd>Hotels, restaurants, commercial and public interiors</dd></div>
        </dl>
      </div>

      <div class="in-grid two">
        <figure><span class="aperture"><Image src={sphAtmo} alt="A room with floating islands of earth and cloud on the walls" widths={[500, 900]} sizes="(max-width: 900px) 94vw, 42vw" /></span><figcaption>Atmosphere</figcaption></figure>
        <figure><span class="aperture"><Image src={sphBio} alt="A circular room lined with a pale, densely grown landscape of plants and animals" widths={[500, 900]} sizes="(max-width: 900px) 94vw, 42vw" /></span><figcaption>Biosphere</figcaption></figure>
      </div>

      <div class="in-award-row">
        <span class="aperture small">
          <Image src={edida} alt="Receiving the EDIDA award on stage with the Freeform team" widths={[280, 560]} sizes="(max-width: 700px) 60vw, 210px" />
        </span>
        <p>EDIDA 2025 — awarded with the Freeform studio.</p>
      </div>

      <ul class="in-press">
        <li><a href="https://www.tecnografica.net/en/collaborations/4121/freeform-e-david-szauder" target="_blank" rel="noopener"><span class="p-outlet">Tecnografica</span><span class="p-title">Freeform &amp; Dávid Szauder — the collection</span><span class="p-arrow">&nearr;</span></a></li>
      </ul>
    </section>

    <!-- DREAM COME TRUE -->
    <section class="in-item rv" id="dream-come-true">
      <div class="in-head">
        <h2>Dream Come True</h2>
        <span class="in-kind">Installation — S/ALON Budapest, 2023</span>
      </div>

      <figure class="in-hero">
        <span class="aperture">
          <Image src={dctHero} alt="A fair stand: a baroque dining table under a moss tablecloth, standing inside a printed garden of ruins and pale mushrooms"
                 widths={[900, 1400, 1600]} sizes="(max-width: 900px) 94vw, 84vw" />
        </span>
      </figure>

      <div class="in-body">
        <div class="in-text">
          <p>An installation for <strong>S/ALON Budapest</strong>, the country's design fair, built
            with the interior design studio <strong>Freeform</strong>. I made the wallpaper: a
            classical garden left to ruin, moss and coral climbing the columns, porcelain creatures
            standing about in it — drawn out of my own porcelain work and the childhood memory of
            figurines nobody was allowed to touch.</p>
          <p>Freeform built the room in front of it. A baroque dining table under a tablecloth of
            live moss, transparent contemporary chairs, antique porcelain set out on the greenery.
            The aim was continuity rather than contrast — the printed garden and the objects standing
            in it are meant to read as one place, and it is not obvious where the image ends.</p>
          <p class="in-award">The most visited installation of the fair — and the beginning of the
            collaboration that became Spheres.</p>
        </div>

        <dl class="in-specs">
          <div><dt>Role</dt><dd>Artist — wallpaper and image world</dd></div>
          <div><dt>With</dt><dd>Freeform, interior design studio</dd></div>
          <div><dt>Where</dt><dd>S/ALON Budapest</dd></div>
          <div><dt>After</dt><dd>Shown in Milan, Berlin and Paris</dd></div>
        </dl>
      </div>

      <figure class="in-hero wide">
        <span class="aperture">
          <Image src={dctWall} alt="The wallpaper itself: broken marble columns and a balustrade in a garden of moss, pink mushrooms and pale porcelain figures"
                 widths={[1000, 1600, 2000]} sizes="(max-width: 900px) 94vw, 84vw" />
        </span>
        <figcaption>The wallpaper, printed at wall scale</figcaption>
      </figure>

      <div class="in-grid two">
        <span class="aperture"><Image src={dct1} alt="Two antique porcelain figurines standing on the moss tablecloth beside a gilded cup and glass" widths={[500, 1000]} sizes="(max-width: 900px) 94vw, 42vw" /></span>
        <span class="aperture"><Image src={dct2} alt="A brass candelabra with white candles on the moss table, a portrait on a screen behind it" widths={[500, 1000]} sizes="(max-width: 900px) 94vw, 42vw" /></span>
      </div>

      <p class="in-credit">Interior and production: Freeform · Photos: Freeform</p>
    </section>

    <p class="in-enquiry rv">
      For interiors, wallcoverings and commissioned works:
      <a href="mailto:davidszauderstudio@gmail.com">davidszauderstudio@gmail.com</a>
    </p>
  </article>
</Base>

<style is:global>
.interior{padding:clamp(110px,15vh,180px) 0 clamp(60px,9vw,120px)}
.interior .tag{display:block;margin-bottom:14px}
.interior h1{font-family:var(--serif);font-size:clamp(2.4rem,6.5vw,5rem);line-height:.98;margin:0;font-weight:400}
.in-lead{color:var(--dust);line-height:1.7;max-width:50ch;margin:24px 0 clamp(46px,6vw,84px);font-size:1.02rem}
.in-item{margin-bottom:clamp(56px,8vw,110px)}
.in-head{display:flex;justify-content:space-between;align-items:baseline;gap:18px;flex-wrap:wrap;
  padding-bottom:16px;margin-bottom:clamp(20px,2.6vw,32px);border-bottom:1px solid var(--hair)}
.in-head h2{font-family:var(--serif);font-size:clamp(1.7rem,3.6vw,2.6rem);font-weight:400;margin:0;line-height:1}
.in-kind{font-family:var(--mono);font-size:.62rem;letter-spacing:.17em;text-transform:uppercase;color:var(--ember)}
.in-hero{margin:0 0 clamp(20px,2.6vw,32px)}
.in-hero.wide{margin-top:clamp(20px,2.6vw,32px)}
.in-hero .aperture img{width:100%}
.interior figcaption{font-family:var(--mono);font-size:.58rem;letter-spacing:.15em;text-transform:uppercase;
  color:var(--dust);margin-top:10px}
.in-body{display:grid;grid-template-columns:1.15fr .85fr;gap:clamp(24px,4vw,60px);align-items:start;
  margin-bottom:clamp(20px,2.6vw,32px)}
.in-text p{color:var(--dust);line-height:1.7;margin:0 0 20px;max-width:52ch;font-size:1.02rem}
.in-text strong{color:var(--bone);font-weight:400}
.in-award{font-family:var(--serif)!important;font-style:italic;color:var(--bone)!important;
  font-size:clamp(1.05rem,1.7vw,1.28rem)!important;padding-left:16px;border-left:1px solid var(--ember)}
.in-specs{margin:0;border-top:1px solid var(--hair)}
.in-specs div{display:grid;grid-template-columns:clamp(80px,9vw,110px) minmax(0,1fr);gap:16px;
  padding:12px 0;border-bottom:1px solid var(--hair)}
.in-specs dt{font-family:var(--mono);font-size:.56rem;letter-spacing:.16em;text-transform:uppercase;color:var(--dust)}
.in-specs dd{margin:0;font-size:.93rem;line-height:1.5}
.in-grid{display:grid;gap:clamp(10px,1.4vw,18px);margin-bottom:clamp(10px,1.4vw,18px)}
.in-grid.two{grid-template-columns:1fr 1fr}
.in-grid figure{margin:0}
.in-grid .aperture img{width:100%}
.in-credit{font-family:var(--mono);font-size:.58rem;letter-spacing:.14em;text-transform:uppercase;
  color:var(--dust);margin:clamp(14px,1.8vw,22px) 0 0}
.in-award-row{display:flex;align-items:center;gap:20px;margin:clamp(20px,2.6vw,32px) 0 0;flex-wrap:wrap}
.in-award-row .aperture.small{flex:0 0 auto;width:clamp(140px,18vw,210px)}
.in-award-row .aperture.small img{width:100%;aspect-ratio:1/1;object-fit:cover}
.in-award-row p{font-family:var(--mono);font-size:.58rem;letter-spacing:.14em;text-transform:uppercase;
  color:var(--dust);margin:0;max-width:26ch;line-height:1.7}
.in-press{list-style:none;margin:clamp(22px,2.8vw,34px) 0 0;padding:0;border-top:1px solid var(--hair)}
.in-press li{border-bottom:1px solid var(--hair)}
.in-press a{display:grid;grid-template-columns:clamp(110px,14vw,160px) minmax(0,1fr) auto;
  gap:clamp(12px,2vw,26px);align-items:baseline;padding:14px 0;transition:padding-left .3s ease}
.in-press a:hover{padding-left:10px}
.in-enquiry{font-family:var(--mono);font-size:.64rem;letter-spacing:.15em;text-transform:uppercase;
  color:var(--dust);margin:0;padding-top:26px;border-top:1px solid var(--hair)}
.in-enquiry a{color:var(--bone);border-bottom:1px solid var(--ember);padding-bottom:3px;margin-left:8px}
@media (max-width:900px){
  .in-body{grid-template-columns:1fr;gap:24px}
  .in-grid.two{grid-template-columns:1fr}
  .in-press a{grid-template-columns:1fr auto;row-gap:5px}
  .in-press .p-outlet{grid-column:1/-1}
}
</style>
