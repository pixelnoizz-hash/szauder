---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';

import hendThumb from '../../assets/commercial/hend-thumb.jpg';
import hendHero from '../../assets/commercial/hend-hero.jpg';
import auerThumb from '../../assets/commercial/auer-thumb.jpg';
import auerHero from '../../assets/commercial/auer-hero.jpg';
import fainPoster from '../../assets/commercial/fain-poster.jpg';
import phi1 from '../../assets/commercial/phi-1.jpg';
import phi2 from '../../assets/commercial/phi-2.jpg';
import phi3 from '../../assets/commercial/phi-3.jpg';
---

<Base title="Commercial — David Szauder"
      description="Brand campaigns: Hendrick's Gin Anotherland, Martin Auer Café Phantastique, FAIN, Phillips.">
  <article class="wrap commercial">
    <header class="rv">
      <span class="tag">Brand work</span>
      <h1>Commercial</h1>
      <p class="cm-lead">Campaigns where a brand asks for a world rather than a picture — built
        with the same studio, the same archive and the same hands as everything else here.</p>
    </header>

    <div class="cm-list">

      <!-- HENDRICK'S -->
      <details class="cm-row rv" name="cmrow">
        <summary class="cm-sum">
          <span class="cm-thumb aperture">
            <Image src={hendThumb} alt="Two figures with giant eyes for heads, seated at a garden table with Hendrick's bottles"
                   widths={[300, 600]} sizes="(max-width: 640px) 92vw, 42vw" />
          </span>
          <span class="cm-meta">
            <span class="cm-kind">Anotherland — 2026</span>
            <h2>Hendrick's Gin</h2>
            <span class="cm-teaser">Six films and a botanical world modelled on a distillery
              that is not open to the public.</span>
          </span>
          <span class="cm-plus" aria-hidden="true"></span>
        </summary>

        <div class="cm-panel">
          <figure class="cm-still">
            <span class="aperture">
              <Image src={hendHero} alt="Two figures with giant eyes for heads raising a hat to each other outside a Victorian glasshouse"
                     widths={[700, 1200]} sizes="(max-width: 900px) 94vw, 84vw" />
            </span>
          </figure>

          <div class="cm-body">
            <div class="cm-text">
              <p>Hendrick's Gin Palace is a real place: a Victorian distillery in Girvan, on the Scottish
                coast, with a cabinet of curiosities, a walled garden and a resident tortoise. It is not
                open to the public. <em>Anotherland</em> is the world built so that people could visit it
                anyway.</p>
              <p>Six short films, set in a botanical world modelled on the Gin Palace, following two
                creatures whose heads are giant eyeballs. The campaign launched the first addition to the
                Hendrick's range in nearly a decade, and extended into live theatrical events — designed
                by the creator of <em>Sleep No More</em> — in New York, Los Angeles, Chicago and Miami,
                then Berlin, Milan and London.</p>
            </div>

            <dl class="cm-specs">
              <div><dt>Role</dt><dd>Creative director and creator — creative visualisation &amp; production, David Szauder Studio</dd></div>
              <div><dt>Agency</dt><dd>Ace of Hearts, London</dd></div>
              <div><dt>Scope</dt><dd>Six films, seven cities</dd></div>
              <div><dt>Studio</dt><dd>Creative producer: Anna Réka Baktay</dd></div>
              <div><dt>Year</dt><dd>2026</dd></div>
            </dl>
          </div>

          <ul class="cm-press">
            <li><a href="https://www.thestable.com.au/hendricks-gin-takes-fans-into-its-whimsical-world-anotherland/" target="_blank" rel="noopener"><span class="p-outlet">The Stable</span><span class="p-title">Hendrick's Gin takes fans into its whimsical world, Anotherland</span><span class="p-arrow">&nearr;</span></a></li>
            <li><a href="https://ialternativemedia.com/how-hendricks-blended-ai-and-theater-for-its-biggest-launchin-a-decade/" target="_blank" rel="noopener"><span class="p-outlet">iAlternative</span><span class="p-title">How Hendrick's blended AI and theatre for its biggest launch in a decade</span><span class="p-arrow">&nearr;</span></a></li>
          </ul>
        </div>
      </details>

      <!-- MARTIN AUER -->
      <details class="cm-row rv" name="cmrow">
        <summary class="cm-sum">
          <span class="cm-thumb aperture">
            <Image src={auerThumb} alt="Two figures whose heads are vintage espresso machines, pouring coffee into their own cups"
                   widths={[300, 600]} sizes="(max-width: 640px) 92vw, 42vw" />
          </span>
          <span class="cm-meta">
            <span class="cm-kind">Café Phantastique — 2026</span>
            <h2>Martin Auer</h2>
            <span class="cm-teaser">A surreal world for an Austrian roastery, started by closing
              my eyes and thinking about coffee.</span>
          </span>
          <span class="cm-plus" aria-hidden="true"></span>
        </summary>

        <div class="cm-panel">
          <figure class="cm-still">
            <span class="aperture">
              <Image src={auerHero} alt="Two figures with espresso-machine heads pouring milk into the cups they hold"
                     widths={[900, 1400, 2000]} sizes="(max-width: 900px) 94vw, 84vw" />
            </span>
          </figure>

          <div class="cm-body">
            <div class="cm-text">
              <p>A campaign for an Austrian bakery and roastery, running across Graz and Klagenfurt.
                The work did not start at a computer. I like coffee a great deal, so the starting point
                was simple: I began thinking about what good coffee does to me, closed my eyes, and
                started to fantasise.</p>
              <p>What came out is a surreal world populated by figures who love coffee so much that
                they almost completely transform under its influence.</p>
            </div>

            <dl class="cm-specs">
              <div><dt>Role</dt><dd>Artist — campaign imagery</dd></div>
              <div><dt>Client</dt><dd>Martin Auer, Graz</dd></div>
              <div><dt>Where</dt><dd>Graz and Klagenfurt, across channels</dd></div>
              <div><dt>Year</dt><dd>2026</dd></div>
            </dl>
          </div>

          <ul class="cm-press">
            <li><a href="https://www.5min.at/graz/5202601231450/martin-auer-startet-ki-kampagne-in-graz-und-klagenfurt/" target="_blank" rel="noopener"><span class="p-outlet">5 Minuten</span><span class="p-title">Martin Auer startet KI-Kampagne in Graz und Klagenfurt</span><span class="p-arrow">&nearr;</span></a></li>
            <li><a href="https://www.kleinezeitung.at/artikel/20493903/martin-auer-serviert-bio-kaffee-mit-einer-ungewoehnlichen-werbekampagne" target="_blank" rel="noopener"><span class="p-outlet">Kleine Zeitung</span><span class="p-title">Martin Auer serviert Bio-Kaffee mit einer ungewöhnlichen Werbekampagne</span><span class="p-arrow">&nearr;</span></a></li>
            <li><a href="https://www.falstaff.com/at/news/grazer-baecker-martin-auer-setzt-auf-ki-kampagne-fuer-kaffee" target="_blank" rel="noopener"><span class="p-outlet">Falstaff</span><span class="p-title">Grazer Bäcker Martin Auer setzt auf KI-Kampagne für Kaffee</span><span class="p-arrow">&nearr;</span></a></li>
          </ul>
        </div>
      </details>

      <!-- FAIN -->
      <details class="cm-row rv" name="cmrow">
        <summary class="cm-sum">
          <span class="cm-thumb aperture">
            <Image src={fainPoster} alt="A figure in a tailcoat with a clock for a head, inside an ornate lift"
                   widths={[220, 440]} sizes="(max-width: 700px) 30vw, 220px" />
          </span>
          <span class="cm-meta">
            <span class="cm-kind">Film — 2026</span>
            <h2>FAIN</h2>
            <span class="cm-teaser">A clock-headed figure, a yellow bird and an ornate lift.</span>
          </span>
          <span class="cm-plus" aria-hidden="true"></span>
        </summary>

        <div class="cm-panel">
          <figure class="cm-film">
            <span class="aperture">
              <video src="/video/fain.mp4" poster={fainPoster.src}
                     muted loop playsinline preload="none"
                     aria-label="Film for FAIN: a figure in a tailcoat with a clock for a head, inside an ornate lift"></video>
            </span>
          </figure>

          <div class="cm-body">
            <div class="cm-text">
              <p>A film for a lift company. A figure in a tailcoat, a clock where the face should be,
                a yellow bird — waiting, riding, and eventually playing the violin inside an ornate
                cabin. A lift is one of the few rooms where strangers agree to stand still together
                and watch the numbers.</p>
            </div>

            <dl class="cm-specs">
              <div><dt>Role</dt><dd>Direction, image</dd></div>
              <div><dt>Client</dt><dd>FAIN</dd></div>
              <div><dt>Year</dt><dd>2026</dd></div>
            </dl>
          </div>
        </div>
      </details>

      <!-- PHILLIPS -->
      <details class="cm-row rv" name="cmrow">
        <summary class="cm-sum">
          <span class="cm-thumb aperture">
            <Image src={phi1} alt="A golden Triceratops head shaped like a lightning bolt, worn by a figure crossing a city street at night"
                   widths={[220, 440]} sizes="(max-width: 700px) 30vw, 220px" />
          </span>
          <span class="cm-meta">
            <span class="cm-kind">Out of This World — 2025</span>
            <h2>Phillips</h2>
            <span class="cm-teaser">The longest gold nugget in the world and a juvenile Triceratops,
              carried through a city.</span>
          </span>
          <span class="cm-plus" aria-hidden="true"></span>
        </summary>

        <div class="cm-panel">
          <div class="cm-grid three portrait">
            <span class="aperture"><Image src={phi1} alt="A golden Triceratops head shaped like a lightning bolt, worn by a figure crossing a city street at night" widths={[380, 700]} sizes="(max-width: 900px) 94vw, 30vw" /></span>
            <span class="aperture"><Image src={phi2} alt="A figure with a Triceratops skull for a head carrying a long gold nugget" widths={[380, 700]} sizes="(max-width: 900px) 94vw, 30vw" /></span>
            <span class="aperture"><Image src={phi3} alt="A boy in a bowler hat holding a large gold nugget shaped like a lightning bolt" widths={[380, 700]} sizes="(max-width: 900px) 94vw, 30vw" /></span>
          </div>

          <div class="cm-body">
            <div class="cm-text">
              <p>A short film for the auction house, made around two objects from Earth's distant past:
                <em>The Thunderbolt</em>, the longest gold nugget in the world at nearly two feet, and
                <em>Cera</em>, the most complete juvenile Triceratops skeleton ever unearthed.</p>
              <p>Both went into the Modern &amp; Contemporary Art evening sale rather than a natural
                history one — objects that fall outside the usual collecting categories. The films treat
                them the same way: not as specimens under glass, but as things that get carried through
                a city by somebody in a hat.</p>
            </div>

            <dl class="cm-specs">
              <div><dt>Role</dt><dd>Artist — moving image</dd></div>
              <div><dt>Client</dt><dd>Phillips</dd></div>
              <div><dt>Sale</dt><dd>Out of This World — Modern &amp; Contemporary Art Evening Sale, New York</dd></div>
              <div><dt>When</dt><dd>19 &amp; 20 November 2025</dd></div>
            </dl>
          </div>
        </div>
      </details>

    </div>

    <p class="cm-enquiry rv">
      For campaigns and brand commissions: <a href="mailto:davidszauderstudio@gmail.com">davidszauderstudio@gmail.com</a>
    </p>
  </article>
</Base>

<script>
  // Play the film only while its row is open.
  document.querySelectorAll('.cm-row').forEach((row) => {
    row.addEventListener('toggle', () => {
      const v = row.querySelector('video');
      if (!v) return;
      if (row.open) { v.play().catch(() => {}); } else { v.pause(); }
    });
  });
</script>

<style is:global>
.commercial{padding:clamp(110px,15vh,180px) 0 clamp(60px,9vw,120px)}
.commercial .tag{display:block;margin-bottom:14px}
.commercial h1{font-family:var(--serif);font-size:clamp(2.4rem,6.5vw,5rem);line-height:.98;margin:0;font-weight:400}
.cm-lead{color:var(--dust);line-height:1.7;max-width:52ch;margin:24px 0 clamp(40px,5vw,64px);font-size:1.02rem}

/* --- the grid --- */
.cm-list{display:grid;grid-template-columns:1fr 1fr;
  column-gap:clamp(20px,3vw,44px);row-gap:clamp(26px,3.6vw,52px)}
.cm-row{border-top:1px solid var(--hair);padding-top:clamp(13px,1.7vw,19px);min-width:0}
.cm-row[open]{grid-column:1/-1}

.cm-sum{display:grid;grid-template-columns:minmax(0,1fr) auto;
  grid-template-areas:"thumb thumb" "meta plus";
  gap:clamp(12px,1.6vw,18px) 16px;cursor:pointer;list-style:none;align-items:end}
.cm-sum::-webkit-details-marker{display:none}
.cm-thumb{grid-area:thumb}
.cm-meta{grid-area:meta;min-width:0}
.cm-plus{grid-area:plus;align-self:end;margin-bottom:4px}

.cm-thumb{display:block;overflow:hidden}
.cm-thumb img{display:block;width:100%;aspect-ratio:4/3;object-fit:cover}

.cm-meta h2{font-family:var(--serif);font-size:clamp(1.35rem,2.6vw,2rem);font-weight:400;
  margin:6px 0 0;line-height:1.05}
.cm-kind{display:block;font-family:var(--mono);font-size:.58rem;letter-spacing:.17em;
  text-transform:uppercase;color:var(--ember)}
.cm-teaser{display:block;color:var(--dust);line-height:1.6;margin-top:10px;max-width:44ch;font-size:.93rem}

.cm-plus{position:relative;width:15px;height:15px;flex:0 0 auto;opacity:.65;transition:opacity .3s ease}
.cm-plus::before,.cm-plus::after{content:'';position:absolute;left:0;top:50%;width:15px;height:1px;
  background:var(--bone)}
.cm-plus::after{transform:rotate(90deg);transition:transform .35s ease}
.cm-sum:hover .cm-plus{opacity:1}
.cm-row[open] .cm-plus{opacity:1}
.cm-row[open] .cm-plus::after{transform:rotate(0deg)}

/* opened: the card spans the full width and lies down */
.cm-row[open] .cm-sum{grid-template-columns:clamp(150px,20vw,250px) minmax(0,1fr) auto;
  grid-template-areas:"thumb meta plus";align-items:center;
  gap:clamp(18px,3vw,40px);padding-bottom:clamp(14px,1.8vw,22px)}
.cm-row[open] .cm-teaser{display:none}
.cm-row[open] .cm-meta h2{font-size:clamp(1.6rem,3.2vw,2.4rem)}

/* --- the panel --- */
.cm-panel{padding:0 0 clamp(26px,3.4vw,44px);animation:cmOpen .4s ease both}
@keyframes cmOpen{from{opacity:0;transform:translateY(-6px)}to{opacity:1;transform:none}}
@media (prefers-reduced-motion:reduce){.cm-panel{animation:none}.cm-sum,.cm-plus{transition:none}}

.cm-still{margin:0 0 clamp(20px,2.6vw,32px)}
.cm-still .aperture img{display:block;width:100%}
.cm-film{margin:0 0 clamp(20px,2.6vw,32px)}
.cm-film .aperture{aspect-ratio:16/10}
.cm-film video{display:block;width:100%;height:100%;object-fit:cover}
.cm-grid{display:grid;gap:clamp(10px,1.4vw,18px);margin-bottom:clamp(20px,2.6vw,32px)}
.cm-grid.three{grid-template-columns:repeat(3,1fr)}
.cm-grid .aperture img{width:100%;aspect-ratio:16/9}
.cm-grid.portrait .aperture img{aspect-ratio:3/4}
.cm-body{display:grid;grid-template-columns:1.15fr .85fr;gap:clamp(24px,4vw,60px);align-items:start}
.cm-text p{color:var(--dust);line-height:1.7;margin:0 0 20px;max-width:52ch;font-size:1.02rem}
.cm-text em{font-style:italic;color:var(--bone)}
.cm-specs{margin:0;border-top:1px solid var(--hair)}
.cm-specs div{display:grid;grid-template-columns:clamp(70px,8vw,96px) minmax(0,1fr);gap:16px;
  padding:12px 0;border-bottom:1px solid var(--hair)}
.cm-specs dt{font-family:var(--mono);font-size:.56rem;letter-spacing:.16em;text-transform:uppercase;color:var(--dust)}
.cm-specs dd{margin:0;font-size:.93rem;line-height:1.5}
.cm-press{list-style:none;margin:clamp(22px,2.8vw,34px) 0 0;padding:0;border-top:1px solid var(--hair)}
.cm-press li{border-bottom:1px solid var(--hair)}
.cm-press li:last-child{border-bottom:0}
.cm-press a{display:grid;grid-template-columns:clamp(110px,14vw,160px) minmax(0,1fr) auto;
  gap:clamp(12px,2vw,26px);align-items:baseline;padding:14px 0;transition:padding-left .3s ease}
.cm-press a:hover{padding-left:10px}
.cm-enquiry{font-family:var(--mono);font-size:.64rem;letter-spacing:.15em;text-transform:uppercase;
  color:var(--dust);margin:clamp(38px,5vw,64px) 0 0;padding-top:26px;border-top:1px solid var(--hair)}
.cm-enquiry a{color:var(--bone);border-bottom:1px solid var(--ember);padding-bottom:3px;margin-left:8px}

@media (max-width:900px){
  .cm-body{grid-template-columns:1fr;gap:24px}
  .cm-row[open] .cm-sum{grid-template-columns:clamp(110px,22vw,160px) minmax(0,1fr) auto}
  .cm-grid.three{grid-template-columns:1fr}
  .cm-press a{grid-template-columns:1fr auto;row-gap:5px}
  .cm-press .p-outlet{grid-column:1/-1}
}
@media (max-width:640px){
  .cm-list{grid-template-columns:1fr;row-gap:clamp(22px,5vw,30px)}
  .cm-row[open] .cm-sum{grid-template-columns:minmax(0,1fr) auto;
    grid-template-areas:"thumb thumb" "meta plus";align-items:end}
  .cm-row[open] .cm-meta h2{font-size:clamp(1.35rem,2.6vw,2rem)}
  .cm-teaser{font-size:.88rem}
}
</style>
