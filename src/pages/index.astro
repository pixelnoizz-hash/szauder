---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Work from '../components/Work.astro';

import hero from '../assets/works/hero.jpg';
import glitchesCover from '../assets/works/glitches-cover.jpg';
import glitchesSpread from '../assets/works/glitches-spread.jpg';

const works = (await getCollection('works')).sort((a, b) => a.data.order - b.data.order);

// the rotating caption under the hero film
const credits = works.map((w) => ({
  work: w.data.title,
  meta: `${w.data.tag} — ${w.data.where === 'Autonomous work' ? 'personal work' : w.data.where}, ${w.data.year}`,
}));

const institutions = [
  'Centre Pompidou', 'Staatsoper Hamburg', 'MUDEC Milano', 'Ars Electronica',
  'Műcsarnok Budapest', 'Kiscelli Museum', 'Ludwig Museum', 'Festival dei Due Mondi',
  'The New Yorker', 'The Washington Post', 'WIRED', 'TED', 'Lumas', 'Gestalten',
];

const routes = [
  { label: 'Studio enquiries', value: 'davidszauderstudio@gmail.com', href: 'mailto:davidszauderstudio@gmail.com' },
  { label: 'Press & images', value: 'press@', href: '#' },
  { label: 'Talks & institutions', value: 'talks@', href: '#' },
  { label: 'Representation', value: 'Agency name', href: '#' },
];
---

<Base>
  <section class="hero">
    <div class="hero-media">
      <Image src={hero} alt="Concert visuals on LED towers before a crowd" widths={[900, 1400, 2000]}
             sizes="100vw" loading="eager" fetchpriority="high" />
    </div>
    <div class="hero-in">
      <h1>David Szauder</h1>
      <p class="hero-line">Builds complete visual worlds.</p>

      <div class="credit" id="credit">
        <div class="credit-slot">
          <span class="credit-work" id="cw">{credits[0].work}</span>
          <span class="credit-meta" id="cm">{credits[0].meta}</span>
        </div>
        <div class="ticks" id="ticks" aria-hidden="true">
          {credits.map(() => <span class="tick"><i></i></span>)}
        </div>
      </div>
    </div>
  </section>

  <div class="wrap works" id="works">
    {works.map((w) => <Work work={w} />)}
  </div>

  <section class="wrap book">
    <div class="book-grid">
      <div class="rv">
        <span class="tag">Monograph</span>
        <h2>Glitches<br />&amp; Glory</h2>
        <p>256 pages on memory, machine intelligence and the image that remembers wrongly. Published by
          Gestalten, with introductions by Jean-Michel Jarre and Lynn Goldsmith.</p>
        <blockquote class="quote">
          A visual manifesto for the meeting of machine and imagination.
          <cite>Jean-Michel Jarre, from the introduction</cite>
        </blockquote>
        <a href="/book" class="btn">See the book</a>
      </div>
      <div class="book-media rv">
        <span class="aperture"><Image src={glitchesCover} alt="Cover of Glitches &amp; Glory" widths={[300, 600]} sizes="30vw" /></span>
        <span class="aperture"><Image src={glitchesSpread} alt="Inside spread from Glitches &amp; Glory" widths={[400, 800]} sizes="35vw" /></span>
      </div>
    </div>
  </section>

  <section class="wrap inst">
    <span class="tag rv">Where the work has been</span>
    <p class="inst-list rv">
      {institutions.map((n, i) => (
        <>
          <span>{n}</span>
          {i < institutions.length - 1 && <span><b>&#9670;</b></span>}
        </>
      ))}
    </p>
  </section>

  <section class="wrap contact" id="contact">
    <span class="tag rv">Contact</span>
    <h2 class="rv">Bring me<br />a world.</h2>
    <dl class="routes rv">
      {routes.map((r) => (
        <div class="route">
          <dt>{r.label}</dt>
          <dd><a href={r.href}>{r.value}</a></dd>
        </div>
      ))}
    </dl>
    <div class="foot">
      <span>&copy; {new Date().getFullYear()} David Szauder — Berlin</span>
      <div class="foot-social">
        <a href="https://www.instagram.com/davidszauder/">Instagram</a>
        <a href="#">Vimeo</a>
        <a href="#">Download CV</a>
      </div>
    </div>
  </section>

  <script define:vars={{ credits }}>
    const cw = document.getElementById('cw');
    const cm = document.getElementById('cm');
    const credit = document.getElementById('credit');
    const ticks = [...document.querySelectorAll('.tick')];
    let i = 0;

    const paint = () => {
      ticks.forEach((t, n) => { t.classList.remove('on', 'done'); if (n < i) t.classList.add('done'); });
      void ticks[i].offsetWidth;
      ticks[i].classList.add('on');
    };
    paint();

    setInterval(() => {
      credit.classList.add('fade');
      setTimeout(() => {
        i = (i + 1) % credits.length;
        cw.textContent = credits[i].work;
        cm.textContent = credits[i].meta;
        credit.classList.remove('fade');
        paint();
      }, 450);
    }, 3600);
  </script>
</Base>

<style is:global>
.hero{position:relative;height:100svh;min-height:560px;overflow:hidden;display:flex;flex-direction:column;justify-content:flex-end}
.hero-media{position:absolute;inset:0}
.hero-media img{width:100%;height:100%;object-fit:cover}
.hero-media::after{content:"";position:absolute;inset:0;
  background:radial-gradient(130% 95% at 50% 30%,transparent 12%,rgba(14,12,14,.42) 62%,rgba(14,12,14,.9) 100%),
             linear-gradient(to top,rgba(14,12,14,.95) 0%,rgba(14,12,14,.4) 34%,transparent 60%)}
.hero-in{position:relative;padding:0 var(--gut) clamp(34px,5vh,64px);max-width:1440px;margin:0 auto;width:100%}
.hero h1{font-family:var(--serif);font-size:clamp(2.9rem,8.4vw,7.2rem);line-height:.94;letter-spacing:-.012em;margin:0;font-weight:400}
.hero-line{font-family:var(--serif);font-style:italic;font-size:clamp(1.15rem,2.4vw,1.9rem);margin:14px 0 0;max-width:24ch;line-height:1.25;opacity:.94}
.credit{margin-top:clamp(30px,5vh,52px);padding-top:16px;border-top:1px solid var(--hair);display:flex;justify-content:space-between;align-items:flex-end;gap:20px;flex-wrap:wrap}
.credit-slot{min-height:2.6em;display:flex;flex-direction:column;gap:6px}
.credit-work{font-family:var(--mono);font-size:clamp(.7rem,1.2vw,.82rem);letter-spacing:.2em;text-transform:uppercase;transition:opacity .5s}
.credit-meta{font-family:var(--mono);font-size:.63rem;letter-spacing:.17em;text-transform:uppercase;color:var(--dust);transition:opacity .5s}
.credit.fade .credit-work,.credit.fade .credit-meta{opacity:0}
.ticks{display:flex;gap:7px;align-items:center;padding-bottom:4px}
.tick{width:24px;height:1.5px;background:var(--hair);position:relative;overflow:hidden}
.tick i{position:absolute;inset:0;background:var(--ember);transform:scaleX(0);transform-origin:left}
.tick.on i{transform:scaleX(1);transition:transform 3.6s linear}
.tick.done i{transform:scaleX(1);background:var(--dust);transition:none}
@media (prefers-reduced-motion:reduce){.tick.on i{transition:none;transform:scaleX(1)}}

.works{padding:clamp(74px,11vw,150px) 0 0}

.book{padding:clamp(56px,8vw,110px) 0}
.book-grid{display:grid;grid-template-columns:1fr 1.05fr;gap:clamp(30px,5vw,80px);align-items:center}
.book h2{font-family:var(--serif);font-size:clamp(2.3rem,6vw,4.4rem);line-height:.98;margin:.2em 0 0;font-weight:400}
.book p{color:var(--dust);line-height:1.65;margin:22px 0 0;max-width:42ch;font-size:1.02rem}
.quote{margin:30px 0 0;padding-left:20px;border-left:1px solid var(--ember);font-family:var(--serif);font-style:italic;font-size:clamp(1.08rem,1.6vw,1.32rem);line-height:1.4;max-width:34ch}
.quote cite{display:block;margin-top:12px;font-family:var(--mono);font-style:normal;font-size:.63rem;letter-spacing:.18em;text-transform:uppercase;color:var(--dust)}
.btn{display:inline-block;margin-top:32px;padding:14px 30px;border:1px solid var(--bone);font-family:var(--mono);font-size:.65rem;letter-spacing:.2em;text-transform:uppercase;transition:background .3s,color .3s}
.btn:hover{background:var(--bone);color:var(--void)}
.book-media{display:grid;grid-template-columns:.86fr 1fr;gap:clamp(12px,1.6vw,22px);align-items:center}

.inst{padding:clamp(50px,7vw,96px) 0}
.inst .tag{display:block;margin-bottom:clamp(24px,3.4vw,40px)}
.inst-list{display:flex;flex-wrap:wrap;align-items:baseline;gap:6px clamp(15px,1.9vw,28px);margin:0}
.inst-list span{font-family:var(--serif);font-size:clamp(1.15rem,2.4vw,1.95rem);line-height:1.34}
.inst-list b{color:var(--ember);font-weight:400;font-size:.68em;transform:translateY(-.18em);display:inline-block}

.contact{padding:clamp(64px,9vw,118px) 0 0;border-top:1px solid var(--hair)}
.contact h2{font-family:var(--serif);font-size:clamp(2.6rem,8vw,6rem);line-height:.94;margin:.16em 0 0;font-weight:400}
.routes{display:grid;grid-template-columns:repeat(4,1fr);gap:clamp(20px,2.6vw,40px);margin:clamp(42px,6vw,72px) 0 0;border-top:1px solid var(--hair);padding-top:28px}
.route dt{font-family:var(--mono);font-size:.62rem;letter-spacing:.18em;text-transform:uppercase;color:var(--dust);margin-bottom:12px}
.route dd{margin:0}
.route a{font-family:var(--serif);font-size:1.12rem;border-bottom:1px solid var(--hair);padding-bottom:3px;transition:border-color .3s}
.route a:hover{border-bottom-color:var(--ember)}
.foot{margin-top:clamp(52px,8vw,92px);padding:22px 0 30px;border-top:1px solid var(--hair);display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap}
.foot,.foot a{font-family:var(--mono);font-size:.62rem;letter-spacing:.15em;text-transform:uppercase;color:var(--dust)}
.foot a:hover{color:var(--bone)}
.foot-social{display:flex;gap:20px}

@media (max-width:1000px){
  .book-grid{grid-template-columns:1fr;gap:34px}
  .book-media{order:-1;max-width:560px}
  .routes{grid-template-columns:repeat(2,1fr);gap:26px}
}
@media (max-width:760px){
  .routes{grid-template-columns:1fr;gap:24px}
  .credit{flex-direction:column;align-items:flex-start;gap:14px}
  .foot{flex-direction:column;gap:12px}
}
</style>
