---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';

import heroPoster from '../assets/works/hero-poster.jpg';
import glitchesCover from '../assets/works/glitches-cover.jpg';
import glitchesSpread from '../assets/works/glitches-spread.jpg';

// ---------------------------------------------------------------------------
// ISTANBUL HERO IMAGE
// TEMPORARY: a phone photo until the professional photographs arrive.
// To swap: put the new file in src/assets/works/ and change the import path below.
// Optional second image (detail) goes in `istanbulDetail` the same way.
// ---------------------------------------------------------------------------
import istanbulHeroImg from '../assets/works/istanbul-saint-benoit-temp.jpg';
const istanbulHero: ImageMetadata | undefined = istanbulHeroImg;
const istanbulDetail: ImageMetadata | undefined = undefined;
const istanbulAlt =
  'Six screens of figures in folk costume with robotic heads, on black draped stands in the nave of Saint Benoît Church, Istanbul, reflected in the marble floor';

// ---------------------------------------------------------------------------
// CURRENT EXHIBITION
// `until` hides the "Current exhibition" label and the "through …" line in the
// visitor's browser once the date has passed — no rebuild needed. The title
// and venue then stay as a plain caption under the hero image.
// To remove the whole block, set `current` to null.
// ---------------------------------------------------------------------------
const current = {
  title: 'Triptych: Memory, Doubt and Fates',
  venue: '212 Photography Istanbul · Saint Benoît Church',
  with: 'with Anna Réka Baktay',
  through: 'through 11 October 2026',
  until: '2026-10-11',
};

// ---------------------------------------------------------------------------
// Homepage copy for each work. Project pages keep their own text in
// src/content/works/*.md — nothing here changes them.
// ---------------------------------------------------------------------------
const HOME: { id: string; tag: string; text: string[]; meta: string; layout: string }[] = [
  {
    id: 'wunderland',
    tag: 'Costume design',
    text: ['A complete costume world for Alexei Ratmansky’s world premiere — conceived digitally and realised by the Staatsoper Hamburg workshops.'],
    meta: 'Hamburg Ballett · Staatsoper Hamburg · 2026',
    layout: 'wide',
  },
  {
    id: 'festival-dei-due-mondi',
    tag: 'Art in public space',
    text: ['Seven historic palazzi became moving surfaces for Evocation of Spirits — a city’s immaterial memory returned to its architecture as image.'],
    meta: 'Festival dei Due Mondi · Spoleto · 2026',
    layout: 'pair',
  },
  {
    id: 'jean-michel-jarre',
    tag: 'Concert visuals',
    text: ['Visuals for three tracks, each a different world, built to hold an arena.'],
    meta: 'Live tour · 2025–2026',
    layout: 'side',
  },
  {
    id: 'babel',
    tag: 'Film',
    text: [
      'In a world built from binaries — black and white, truth and illusion — we march forward without knowing where we are going.',
      'Shown on the TED stage and in a solo exhibition in New York.',
    ],
    meta: 'Autonomous work · 2025',
    layout: 'side-rev',
  },
];

const ALT: Record<string, string[]> = {
  wunderland: [
    'Wunderland at the Staatsoper Hamburg: the Queen of Hearts in red and gold, surrounded by dancers costumed as playing cards',
    'Wunderland: Alice between Tweedledum and Tweedledee in padded striped costumes',
    'Wunderland: Alice seated on the stage beneath a dancer costumed as a winged insect',
  ],
  'festival-dei-due-mondi': [
    'Evocation of Spirits in Spoleto at night: a pale branching figure projected onto a medieval stone tower',
    'Evocation of Spirits: a palazzo façade with a clock flooded in red projected imagery',
  ],
  'jean-michel-jarre': [
    'Jean-Michel Jarre in concert: a red-lit arena stage with towering screens of masked figures',
  ],
  babel: [
    'Babel: rows of white, faceless figures in ribbed costumes receding into darkness',
    'Babel: two white-robed figures seated and joined by a red thread',
  ],
};

const all = await getCollection('works');
const works = HOME.map((h) => {
  const w = all.find((x) => x.id === h.id);
  if (!w) throw new Error(`index.astro: no work "${h.id}"`);
  return { ...h, href: `/works/${w.id}`, title: w.data.title, images: [w.data.cover, ...w.data.gallery],
           credit: w.data.photoCredit, alt: ALT[h.id] ?? [] };
});
const [wunderland, spoleto, jarre, babel] = works;

const contexts = [
  'Centre Pompidou', 'Staatsoper Hamburg', 'Festival dei Due Mondi', 'MUDEC Milano',
  'Ars Electronica', 'The New Yorker', 'The Washington Post', 'WIRED', 'TED', 'Gestalten',
  'Oxford University Press',
];

const routes = [
  { label: 'Studio enquiries', value: 'davidszauderstudio@gmail.com', href: 'mailto:davidszauderstudio@gmail.com' },
  { label: 'Press & images', value: 'davidszauderstudio@gmail.com', href: 'mailto:davidszauderstudio@gmail.com' },
  { label: 'Moving image', value: '@davidszauder', href: 'https://www.instagram.com/davidszauder/' },
  { label: 'Bio & CV', value: 'Full biography', href: '/bio' },
];
---

<Base>
  <div class="home">

    <!-- Hero: showreel video, as before -->
    <section class="h-vhero">
      <div class="h-vhero-media">
        <Image src={heroPoster} alt="" class="hero-poster" widths={[900, 1600]} sizes="100vw"
               loading="eager" fetchpriority="high" />
        <video class="hero-video" src="/video/hero.mp4" poster={heroPoster.src}
               autoplay muted loop playsinline preload="auto"
               aria-label="Showreel"></video>
      </div>
      <div class="h-vhero-in">
        <h1>David Szauder</h1>
        <p class="h-tagline">Builds complete visual universes.</p>
        <p class="h-lede">Artist and visual director working across image, moving image, stage, costume and space.</p>
      </div>
    </section>

    <!-- Current work: Istanbul -->
    <section class="wrap h-now" aria-label="Current exhibition">
      {istanbulHero ? (
        <figure class="h-hero">
          <Image src={istanbulHero} alt={istanbulAlt} widths={[900, 1400, 2000]}
                 sizes="(max-width: 760px) 100vw, 92vw" />
        </figure>
      ) : import.meta.env.DEV && (
        <div class="h-hero h-hero--empty" aria-hidden="true">
          <span>Istanbul image — waiting for the Saint Benoît photographs</span>
        </div>
      )}

      {current && (
        <div class="h-cx" data-until={current.until}>
          {istanbulDetail && (
            <Image class="h-cx-detail" src={istanbulDetail} alt={`${istanbulAlt}, detail`}
                   widths={[500, 900]} sizes="(max-width: 760px) 100vw, 30vw" />
          )}
          <div class="h-cx-text">
            <span class="h-cx-label js-current">Current exhibition</span>
            <p class="h-cx-title">{current.title}</p>
            <p class="h-cx-venue">{current.venue}<br />{current.with}</p>
            <p class="h-cx-date js-current">{current.through}</p>
          </div>
        </div>
      )}
    </section>

    <!-- Works -->
    <div class="wrap h-works" id="works">

      <!-- Wunderland: one wide image, then text beside a pair -->
      <article class="h-work h-work--wide rv">
        <a class="aperture h-img h-img--wide" href={wunderland.href} tabindex="-1" aria-hidden="true">
          <Image src={wunderland.images[0]} alt="" widths={[900, 1400, 2000]} sizes="92vw" />
        </a>
        <div class="h-wide-row">
          <div class="h-body">
            <span class="h-tag">{wunderland.tag}</span>
            <h2 class="h-title"><a href={wunderland.href}>{wunderland.title}</a></h2>
            {wunderland.text.map((t) => <p class="h-text">{t}</p>)}
            <p class="h-meta">{wunderland.meta}</p>
            <a class="h-enter" href={wunderland.href}>Enter the work <span aria-hidden="true">→</span></a>
          </div>
          <div class="h-pair">
            {wunderland.images.slice(1, 3).map((img, i) => (
              <span class="aperture h-img"><Image src={img} alt={wunderland.alt[i + 1]} widths={[500, 900]} sizes="(max-width: 1000px) 46vw, 28vw" /></span>
            ))}
          </div>
        </div>
        <p class="h-credit">{wunderland.credit}</p>
      </article>

      <!-- Spoleto: offset image pair, text underneath on the right -->
      <article class="h-work h-work--pair rv">
        <div class="h-offset">
          <a class="aperture h-img h-offset-a" href={spoleto.href} tabindex="-1" aria-hidden="true">
            <Image src={spoleto.images[0]} alt="" widths={[900, 1400]} sizes="(max-width: 760px) 100vw, 58vw" />
          </a>
          <span class="aperture h-img h-offset-b">
            <Image src={spoleto.images[1]} alt={spoleto.alt[1]} widths={[500, 900]} sizes="(max-width: 760px) 100vw, 34vw" />
          </span>
        </div>
        <div class="h-body h-body--right">
          <span class="h-tag">{spoleto.tag}</span>
          <h2 class="h-title"><a href={spoleto.href}>{spoleto.title}</a></h2>
          {spoleto.text.map((t) => <p class="h-text">{t}</p>)}
          <p class="h-meta">{spoleto.meta}</p>
          <a class="h-enter" href={spoleto.href}>Enter the work <span aria-hidden="true">→</span></a>
        </div>
      </article>

      <!-- Jean-Michel Jarre: large image left, text right -->
      <article class="h-work h-work--side rv">
        <a class="aperture h-img h-side-img" href={jarre.href} tabindex="-1" aria-hidden="true">
          <Image src={jarre.images[0]} alt="" widths={[700, 1100]} sizes="(max-width: 1000px) 100vw, 58vw" />
        </a>
        <div class="h-body">
          <span class="h-tag">{jarre.tag}</span>
          <h2 class="h-title"><a href={jarre.href}>{jarre.title}</a></h2>
          {jarre.text.map((t) => <p class="h-text">{t}</p>)}
          <p class="h-meta">{jarre.meta}</p>
          <a class="h-enter" href={jarre.href}>Enter the work <span aria-hidden="true">→</span></a>
        </div>
      </article>

      <!-- Babel: text left, two images right -->
      <article class="h-work h-work--side h-work--rev rv">
        <div class="h-stack">
          <a class="aperture h-img" href={babel.href} tabindex="-1" aria-hidden="true">
            <Image src={babel.images[0]} alt="" widths={[700]} sizes="(max-width: 1000px) 100vw, 44vw" />
          </a>
          <span class="aperture h-img h-stack-b">
            <Image src={babel.images[2]} alt={babel.alt[1]} widths={[558]} sizes="(max-width: 1000px) 70vw, 26vw" />
          </span>
        </div>
        <div class="h-body">
          <span class="h-tag">{babel.tag}</span>
          <h2 class="h-title"><a href={babel.href}>{babel.title}</a></h2>
          {babel.text.map((t) => <p class="h-text">{t}</p>)}
          <p class="h-meta">{babel.meta}</p>
          <a class="h-enter" href={babel.href}>Enter the work <span aria-hidden="true">→</span></a>
        </div>
      </article>
    </div>

    <!-- Monograph -->
    <section class="wrap h-book">
      <div class="h-book-grid">
        <div class="h-body rv">
          <span class="h-tag">Monograph</span>
          <h2 class="h-title">Glitches &amp; Glory</h2>
          <p class="h-text">256 pages of twelve years of work — the series, the failures kept on purpose, and the archive they were built from.</p>
          <p class="h-meta">gestalten · 2025</p>
          <figure class="h-quote">
            <blockquote><p>“For almost 42 years, I haven’t been able to decide whether I’m an artist or a programmer.”</p></blockquote>
            <figcaption>From the afterword</figcaption>
          </figure>
          <a class="h-enter" href="/book">See the book <span aria-hidden="true">→</span></a>
        </div>
        <div class="h-book-media rv">
          <span class="aperture"><Image src={glitchesCover} alt="Cover of Glitches & Glory: a turquoise figure with large eyes among strange plant-like creatures" widths={[400, 700]} sizes="(max-width: 1000px) 44vw, 24vw" /></span>
          <span class="aperture"><Image src={glitchesSpread} alt="Glitches & Glory opened to a spread with a collaged portrait" widths={[500, 900]} sizes="(max-width: 1000px) 50vw, 28vw" /></span>
        </div>
      </div>
    </section>

    <!-- Selected contexts -->
    <section class="wrap h-ctx" aria-labelledby="ctx-h">
      <h2 id="ctx-h" class="h-tag">Selected contexts</h2>
      <ul class="h-ctx-list rv">
        {contexts.map((n) => <li>{n}</li>)}
      </ul>
    </section>

    <!-- Contact -->
    <section class="wrap h-contact" id="contact">
      <h2 class="h-tag">Contact</h2>
      <dl class="h-routes rv">
        {routes.map((r) => (
          <div class="h-route">
            <dt>{r.label}</dt>
            <dd><a href={r.href}>{r.value}</a></dd>
          </div>
        ))}
      </dl>
      <div class="h-foot">
        <span>&copy; {new Date().getFullYear()} David Szauder — Vienna · Budapest</span>
        <div class="h-foot-social">
          <a href="https://www.instagram.com/davidszauder/">Instagram</a>
          <a href="#">Vimeo</a>
          <a href="#">Download CV</a>
        </div>
      </div>
    </section>
  </div>

  <script>
    const v = document.querySelector<HTMLVideoElement>('.hero-video');
    if (v) {
      const show = () => v.classList.add('ready');
      if (v.readyState >= 3) show();
      v.addEventListener('playing', show, { once: true });
      v.play().catch(() => {});
    }

    // Hide "Current exhibition" and the closing date once the show is over.
    document.querySelectorAll<HTMLElement>('.h-cx[data-until]').forEach((el) => {
      const until = new Date(el.dataset.until + 'T23:59:59');
      if (Date.now() > until.getTime()) {
        el.querySelectorAll<HTMLElement>('.js-current').forEach((n) => (n.hidden = true));
      }
    });
  </script>
</Base>

<!-- Every selector below is scoped to .home: nothing outside the homepage changes. -->
<style is:global>
.home{
  --h-gap:clamp(76px,11vw,168px);
  --h-col:clamp(24px,4vw,72px);
}
.home .h-img img{width:100%;height:100%;object-fit:cover}

/* --- video hero (unchanged behaviour, larger type) --- */
.home .h-vhero{position:relative;height:100svh;min-height:560px;overflow:hidden;display:flex;flex-direction:column;justify-content:flex-end}
.home .h-vhero-media{position:absolute;inset:0}
.home .h-vhero-media img,.home .h-vhero-media video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.home .hero-video{opacity:0;transition:opacity 1.1s ease}
.home .hero-video.ready{opacity:1}
@media (prefers-reduced-motion:reduce){.home .hero-video{display:none}}
.home .h-vhero-media::after{content:"";position:absolute;inset:0;
  background:radial-gradient(130% 95% at 50% 30%,transparent 12%,rgba(14,12,14,.42) 62%,rgba(14,12,14,.9) 100%),
             linear-gradient(to top,rgba(14,12,14,.95) 0%,rgba(14,12,14,.4) 34%,transparent 60%)}
.home .h-vhero-in{position:relative;padding:0 var(--gut) clamp(34px,6vh,72px);max-width:1440px;margin:0 auto;width:100%}
.home .h-vhero .h-lede{color:var(--bone);opacity:.82}
.home h1{font-family:var(--serif);font-weight:400;font-size:clamp(3.4rem,7vw,7rem);line-height:.94;letter-spacing:-.012em;margin:0}
.home .h-tagline{font-family:var(--serif);font-style:italic;font-size:clamp(1.8rem,3.5vw,3.4rem);line-height:1.12;
  margin:clamp(14px,1.6vw,22px) 0 0;max-width:22ch}
.home .h-lede{font-size:clamp(1.0625rem,.95rem + .6vw,1.375rem);line-height:1.4;color:var(--dust);
  margin:clamp(20px,2.4vw,32px) 0 0;max-width:42ch}

/* --- current exhibition --- */
.home .h-now{margin-top:clamp(76px,10vw,150px)}
.home .h-hero{margin:0}
.home .h-hero img{width:100%;height:auto}
.home .h-hero--empty{aspect-ratio:16/9;display:grid;place-items:center;border:1px dashed var(--dust);
  font-family:var(--mono);font-size:.8rem;letter-spacing:.14em;text-transform:uppercase;color:var(--dust);text-align:center;padding:20px}
.home .h-cx{display:flex;gap:var(--h-col);align-items:flex-start;margin-top:clamp(26px,3vw,40px)}
.home .h-cx-detail{width:clamp(160px,24vw,340px);height:auto;flex:0 0 auto}
.home .h-cx-text{max-width:46ch}
.home .h-cx-label{display:block;font-family:var(--mono);font-size:.78rem;letter-spacing:.18em;text-transform:uppercase;color:var(--dust);margin-bottom:12px}
.home .h-cx-title{font-family:var(--serif);font-size:clamp(1.25rem,1rem + 1vw,1.75rem);line-height:1.2;margin:0}
.home .h-cx-venue{font-size:clamp(.9375rem,.9rem + .2vw,1.0625rem);line-height:1.5;color:var(--dust);margin:10px 0 0}
.home .h-cx-date{font-size:clamp(.9375rem,.9rem + .2vw,1.0625rem);line-height:1.5;color:var(--bone);margin:4px 0 0}
.home [hidden]{display:none!important}

/* --- works: shared --- */
.home .h-works{padding-top:var(--h-gap)}
.home .h-work{margin-bottom:var(--h-gap)}
.home .h-tag{display:block;font-family:var(--mono);font-weight:400;font-size:clamp(.8125rem,.78rem + .15vw,.9rem);
  letter-spacing:.18em;text-transform:uppercase;color:var(--dust);margin:0 0 clamp(14px,1.6vw,20px)}
.home .h-title{font-family:var(--serif);font-weight:400;font-size:clamp(2.1rem,4.5vw,4rem);line-height:1;margin:0}
.home .h-title a{transition:color .3s ease}
.home .h-title a:hover{color:var(--dust)}
.home .h-text{font-size:clamp(1.125rem,1rem + .5vw,1.4rem);line-height:1.5;color:var(--bone);max-width:36ch;margin:clamp(20px,2.2vw,30px) 0 0}
.home .h-text + .h-text{margin-top:14px;color:var(--dust)}
.home .h-meta{font-size:clamp(.9375rem,.92rem + .1vw,1rem);line-height:1.5;color:var(--dust);margin:clamp(18px,2vw,26px) 0 0}
.home .h-enter{display:inline-flex;align-items:center;gap:10px;margin-top:clamp(24px,2.6vw,34px);font-family:var(--mono);
  font-size:clamp(.875rem,.85rem + .1vw,.95rem);letter-spacing:.16em;text-transform:uppercase;padding-bottom:6px;
  border-bottom:1px solid var(--ember);transition:gap .3s ease}
.home .h-enter:hover{gap:18px}
.home .h-credit{font-family:var(--mono);font-size:.72rem;letter-spacing:.12em;text-transform:uppercase;color:var(--dust);margin:14px 0 0}
.home a.aperture:hover img{transform:scale(1.02)}
@media (prefers-reduced-motion:reduce){.home a.aperture:hover img{transform:none}}

/* Wunderland — wide */
.home .h-img--wide{aspect-ratio:16/9;max-height:84vh;width:100%}
.home .h-img--wide img{object-position:50% 8%}
@media (max-width:760px){.home .h-img--wide{aspect-ratio:3/2;max-height:none;width:auto}}
.home .h-wide-row{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:var(--h-col);align-items:start;margin-top:clamp(40px,5vw,72px)}
.home .h-pair{display:grid;grid-template-columns:1fr 1fr;gap:clamp(10px,1.2vw,18px)}
.home .h-pair .h-img{aspect-ratio:3/2}

/* Spoleto — offset pair */
.home .h-offset{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(0,1fr);gap:clamp(12px,1.6vw,24px);align-items:start}
.home .h-offset-a{aspect-ratio:3/2}
.home .h-offset-b{aspect-ratio:3/2;margin-top:clamp(60px,12vw,200px)}
.home .h-body--right{margin:clamp(40px,5vw,72px) 0 0 auto;width:min(100%,640px)}

/* Jarre / Babel — side by side */
.home .h-work--side{display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);gap:var(--h-col);align-items:center}
.home .h-side-img{aspect-ratio:3/2}
.home .h-work--rev{grid-template-columns:minmax(0,5fr) minmax(0,6fr)}
.home .h-work--rev .h-body{order:-1}
.home .h-stack{display:grid;grid-template-columns:repeat(10,1fr)}
.home .h-stack > :first-child{grid-column:1/10;aspect-ratio:3/2}
.home .h-stack-b{grid-column:5/11;aspect-ratio:3/2;margin-top:clamp(-80px,-6vw,-40px)}

/* --- monograph --- */
.home .h-book{padding-top:clamp(20px,3vw,40px);padding-bottom:var(--h-gap)}
.home .h-book-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.05fr);gap:var(--h-col);align-items:center}
.home .h-book-media{display:grid;grid-template-columns:.86fr 1fr;gap:clamp(12px,1.6vw,22px);align-items:center}
.home .h-quote{margin:clamp(36px,4vw,52px) 0 0;max-width:22em}
.home .h-quote blockquote{margin:0}
.home .h-quote p{font-family:var(--serif);font-style:italic;font-size:clamp(1.2rem,1rem + .9vw,1.75rem);line-height:1.3;margin:0;text-indent:-.42em}
.home .h-quote figcaption{font-family:var(--mono);font-size:.75rem;letter-spacing:.16em;text-transform:uppercase;color:var(--dust);margin-top:14px}

/* --- selected contexts --- */
.home .h-ctx{padding-top:clamp(48px,6vw,88px);padding-bottom:clamp(48px,6vw,88px);border-top:1px solid var(--hair)}
.home .h-ctx-list{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;align-items:baseline;gap:8px 0;max-width:1180px}
.home .h-ctx-list li{font-family:var(--serif);font-size:clamp(1.25rem,1rem + 1.1vw,1.9rem);line-height:1.35}
.home .h-ctx-list li:not(:last-child)::after{content:"◆";color:var(--ember);font-size:.55em;display:inline-block;
  transform:translateY(-.3em);margin:0 clamp(12px,1.5vw,22px)}

/* --- contact --- */
.home .h-contact{padding-top:clamp(64px,9vw,118px);border-top:1px solid var(--hair)}
.home .h-routes{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:clamp(20px,2.6vw,40px);margin:0;padding-top:28px;border-top:1px solid var(--hair)}
.home .h-route dt{font-family:var(--mono);font-size:.78rem;letter-spacing:.16em;text-transform:uppercase;color:var(--dust);margin-bottom:12px}
.home .h-route dd{margin:0}
.home .h-route a{font-family:var(--serif);font-size:clamp(1.125rem,1rem + .4vw,1.3rem);border-bottom:1px solid var(--hair);padding-bottom:3px;
  transition:border-color .3s;overflow-wrap:anywhere}
.home .h-route a:hover{border-bottom-color:var(--ember)}
