---

<Base title="Archive — David Szauder" description="A chronological index of David Szauder's projects, 2011 to 2024.">
  <article class="wrap archive">
    <header class="rv">
      <span class="tag">Archive</span>
      <h1>Earlier work</h1>
      <p class="arch-lead">Projects from 2011 onward. Individual pages are being rebuilt —
        if you arrived from a catalogue or an article and need material on a particular work,
        <a href="mailto:davidszauderstudio@gmail.com">write to the studio</a>.</p>
    </header>

    <ul class="arch-list rv">
      {archive.map((a) => (
        <li id={a.slug} class="arch-row">
          <span class="arch-year">{a.year}</span>
          <span class="arch-title">{a.title}</span>
        </li>
      ))}
    </ul>
  </article>
</Base>

<style is:global>
.archive{padding:clamp(110px,15vh,180px) 0 clamp(60px,9vw,120px)}
.archive .tag{display:block;margin-bottom:14px}
.archive h1{font-family:var(--serif);font-size:clamp(2.4rem,6.5vw,5rem);line-height:.98;margin:0;font-weight:400}
.arch-lead{color:var(--dust);line-height:1.7;max-width:56ch;margin:24px 0 clamp(34px,4.5vw,58px);font-size:1rem}
.arch-lead a{border-bottom:1px solid var(--ember);padding-bottom:2px;color:var(--bone)}
.arch-list{list-style:none;margin:0;padding:0;border-top:1px solid var(--hair)}
.arch-row{display:grid;grid-template-columns:clamp(90px,10vw,130px) minmax(0,1fr);gap:clamp(12px,2vw,26px);
  align-items:baseline;padding:15px 0;border-bottom:1px solid var(--hair);scroll-margin-top:110px}
.arch-row:target{background:rgba(179,58,43,.10);padding-left:12px;padding-right:12px}
.arch-year{font-family:var(--mono);font-size:.6rem;letter-spacing:.14em;text-transform:uppercase;color:var(--dust)}
.arch-title{font-family:var(--serif);font-size:clamp(1rem,1.6vw,1.24rem);line-height:1.3}
@media (max-width:640px){ .arch-row{grid-template-columns:1fr;row-gap:5px} }
</style>
