---
import { Image } from 'astro:assets';
const { work } = Astro.props;
const d = work.data;
---
<article class="work rv">
  <div class="work-media">
    <a class="aperture" href={`/works/${work.id}`}>
      <Image src={d.cover} alt={`${d.title} — ${d.tag}`} widths={[600, 900, 1400]}
             sizes="(max-width: 1000px) 92vw, 55vw" class="cover" />
    </a>
    {d.gallery.length > 0 && (
      <div class={`strip ${d.gallery.length === 3 ? 'three' : ''}`}>
        {d.gallery.map((img: any, i: number) => (
          <span class="aperture">
            <Image src={img} alt={`${d.title}, image ${i + 2}`} widths={[380, 600]}
                   sizes="(max-width: 1000px) 46vw, 27vw" />
          </span>
        ))}
      </div>
    )}
    {d.photoCredit && <p class="photo-credit">{d.photoCredit}</p>}
  </div>

  <div class="work-body">
    <span class="tag">{d.tag}</span>
    <h2 class="work-title">{d.title}</h2>
    <p class="work-note">{d.note}</p>
    {d.from && <p class="from">{d.from}</p>}
    <dl class="specs">
      <div class="spec"><dt>Role</dt><dd>{d.role}</dd></div>
      <div class="spec"><dt>Where</dt><dd>{d.where}</dd></div>
      <div class="spec"><dt>Year</dt><dd>{d.year}</dd></div>
    </dl>
    <a href={`/works/${work.id}`} class="enter">Enter the work &rarr;</a>
  </div>
</article>

<style is:global>
.work{display:grid;grid-template-columns:1.5fr 1fr;gap:clamp(26px,4vw,64px);align-items:center;margin-bottom:clamp(70px,10vw,140px)}
.work:nth-of-type(even) .work-media{order:2}
.work:nth-of-type(even) .work-body{order:1}
.work-media>.aperture img.cover{aspect-ratio:3/2}
.work:hover .work-media>.aperture img{transform:scale(1.02)}
.work:hover .aperture::after{box-shadow:inset 0 0 90px 4px rgba(14,12,14,.2)}
@media (prefers-reduced-motion:reduce){.work:hover .work-media>.aperture img{transform:none}}
.strip{display:grid;grid-template-columns:1fr 1fr;gap:clamp(8px,1vw,14px);margin-top:clamp(8px,1vw,14px)}
.strip.three{grid-template-columns:1fr 1fr 1fr}
.strip .aperture img{aspect-ratio:3/2}
.photo-credit{font-family:var(--mono);font-size:.57rem;letter-spacing:.14em;text-transform:uppercase;color:var(--dust);margin:10px 0 0;opacity:.7}
.work-body .tag{display:block;margin-bottom:16px}
.work-title{font-family:var(--serif);font-size:clamp(1.85rem,4vw,3.1rem);line-height:1.02;margin:0;font-weight:400}
.work-note{font-size:clamp(.95rem,1.2vw,1.03rem);line-height:1.6;color:var(--dust);margin:18px 0 0;max-width:38ch}
.from{margin:16px 0 0;padding-left:14px;border-left:1px solid var(--ember);font-family:var(--serif);font-style:italic;font-size:1.02rem;line-height:1.4;max-width:34ch}
.specs{margin:24px 0 0;padding-top:16px;border-top:1px solid var(--hair);display:grid;gap:9px}
.spec{display:flex;gap:14px;font-family:var(--mono);font-size:.65rem;letter-spacing:.13em;text-transform:uppercase}
.spec dt{color:var(--dust);min-width:66px;flex:0 0 auto}
.spec dd{margin:0}
.enter{display:inline-flex;align-items:center;gap:10px;margin-top:24px;font-family:var(--mono);font-size:.66rem;letter-spacing:.2em;text-transform:uppercase;padding-bottom:5px;border-bottom:1px solid var(--ember);transition:gap .3s}
.work:hover .enter{gap:18px}
@media (max-width:1000px){
  .work{grid-template-columns:1fr;gap:24px}
  .work:nth-of-type(even) .work-media,.work:nth-of-type(even) .work-body{order:0}
}
</style>
