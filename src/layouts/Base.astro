---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: ImageMetadata;
}
const {
  title = 'David Szauder — Complete visual worlds',
  description = 'David Szauder builds complete visual universes for stage, architecture, concert and print.',
  ogImage,
} = Astro.props;

const share = ogImage ? new URL(ogImage.src, Astro.site).href : new URL('/og.jpg', Astro.site).href;

const canonical = new URL(Astro.url.pathname, Astro.site).href.replace(/\/$/, '') || Astro.site!.href;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'David Szauder',
  alternateName: 'Dávid Szauder',
  birthDate: '1976',
  jobTitle: 'Visual artist',
  description:
    'Visual artist working between conceptual art, machine learning and visual culture. Costume design, concert visuals, projection and editorial illustration.',
  url: 'https://www.davidarielszauder.com',
  image: 'https://www.davidarielszauder.com/og.jpg',
  sameAs: ['https://www.instagram.com/davidszauder/'],
  knowsAbout: ['Generative image', 'Costume design', 'Concert visuals', 'Projection', 'Editorial illustration'],
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Hungarian University of Fine Arts' },
  worksFor: { '@type': 'Organization', name: 'Szauder Studio' },
  address: { '@type': 'PostalAddress', addressLocality: 'Berlin', addressCountry: 'DE' },
};

// Only pages that actually exist. Add back as they are built.
const nav = [
  { label: 'Book', href: '/book' },
  { label: 'Talks & Teaching', href: '/talks' },
  { label: 'Bio', href: '/bio' },
  { label: 'Contact', href: '/#contact' },
];
const worksMenu = [
  { label: 'Wunderland', href: '/works/wunderland' },
  { label: 'Festival dei Due Mondi', href: '/works/festival-dei-due-mondi' },
  { label: 'Concert visuals', href: '/works/concert' },
  { label: 'Babel', href: '/works/babel' },
  { label: 'Editorial', href: '/works/editorial' },
  { label: 'Commercial', href: '/works/commercial' },
  { label: 'Ars Electronica', href: '/works/ars-electronica' },
  { label: 'Interior', href: '/works/interior' },
  { label: 'Archive', href: '/archive' },
];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <meta name="author" content="David Szauder" />
  <meta property="og:site_name" content="David Szauder" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={share} />
  <meta property="og:image:width" content={String(ogImage?.width ?? 1200)} />
  <meta property="og:image:height" content={String(ogImage?.height ?? 630)} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={share} />
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400..600;1,400&family=Instrument+Serif:ital@0;1&family=Space+Mono:wght@400;700&display=swap"
    rel="stylesheet"
  />
</head>
<body>

<header class="nav" id="nav">
  <div class="wrap nav-in">
    <a href="/" class="logo">David Szauder</a>

    <nav aria-label="Main">
      <ul class="menu">
        <li>
          <button aria-haspopup="true" aria-expanded="false">Works <i class="caret"></i></button>
          <ul class="drop">
            {worksMenu.map((i) => <li><a href={i.href}>{i.label}</a></li>)}
          </ul>
        </li>
        {nav.map((i) => <li><a href={i.href}>{i.label}</a></li>)}
      </ul>
    </nav>

    <button class="burger" id="burger" aria-label="Open menu" aria-expanded="false" aria-controls="panel">
      <span></span><span></span>
    </button>
  </div>
</header>

<div class="panel" id="panel" hidden>
  <ul>
    <li>
      <button class="acc-btn" aria-expanded="false" aria-controls="acc-works">Works <i class="acc-sign"></i></button>
      <div class="acc-body" id="acc-works">
        <ul>{worksMenu.map((i) => <li><a href={i.href}>{i.label}</a></li>)}</ul>
      </div>
    </li>
    {nav.map((i) => <li><a href={i.href}>{i.label}</a></li>)}
  </ul>
</div>

<main><slot /></main>

<script>
  const nav = document.getElementById('nav')!;
  const onScroll = () => nav.classList.toggle('solid', window.scrollY > 40);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const burger = document.getElementById('burger') as HTMLButtonElement;
  const panel = document.getElementById('panel') as HTMLElement;

  burger.addEventListener('click', () => {
    const open = panel.classList.contains('open');
    if (open) {
      panel.classList.remove('open');
      burger.classList.remove('on');
      burger.setAttribute('aria-expanded', 'false');
      burger.setAttribute('aria-label', 'Open menu');
      document.body.style.overflow = '';
      setTimeout(() => { if (!panel.classList.contains('open')) panel.hidden = true; }, 500);
    } else {
      panel.hidden = false;
      requestAnimationFrame(() => panel.classList.add('open'));
      burger.classList.add('on');
      burger.setAttribute('aria-expanded', 'true');
      burger.setAttribute('aria-label', 'Close menu');
      document.body.style.overflow = 'hidden';
    }
  });

  panel.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => { if (panel.classList.contains('open')) burger.click(); })
  );

  // submenus open on click only, as agreed
  panel.querySelectorAll<HTMLButtonElement>('.acc-btn').forEach((btn) => {
    const body = document.getElementById(btn.getAttribute('aria-controls')!)!;
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
      body.style.maxHeight = open ? '0px' : body.scrollHeight + 'px';
    });
  });

  const io = new IntersectionObserver(
    (es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }),
    { threshold: 0.12, rootMargin: '0px 0px -6% 0px' }
  );
  document.querySelectorAll('.rv').forEach((el) => io.observe(el));
</script>

<style is:global>
.nav{position:fixed;inset:0 0 auto 0;z-index:80;padding:20px 0;transition:background .4s,padding .4s,border-color .4s;border-bottom:1px solid transparent}
.nav.solid{background:rgba(14,12,14,.9);backdrop-filter:blur(16px);padding:13px 0;border-bottom-color:var(--hair)}
.nav-in{display:flex;align-items:center;justify-content:space-between;gap:22px}
.logo{font-family:var(--serif);font-size:clamp(1.15rem,1.7vw,1.4rem)}
.menu{display:flex;align-items:center;gap:clamp(16px,2.2vw,32px);list-style:none;margin:0;padding:0}
.menu>li{position:relative}
.menu>li>a,.menu>li>button{font-family:var(--mono);font-size:.66rem;letter-spacing:.2em;text-transform:uppercase;padding:9px 0;display:inline-flex;align-items:center;gap:8px;transition:color .25s}
.menu>li>a:hover,.menu>li>button:hover{color:var(--dust)}
.caret{width:6px;height:6px;border-right:1.2px solid;border-bottom:1.2px solid;transform:rotate(45deg) translate(-2px,-2px);transition:transform .3s}
.menu>li:hover .caret,.menu>li:focus-within .caret{transform:rotate(225deg) translate(-3px,-3px)}
.drop{position:absolute;top:100%;left:-20px;min-width:250px;padding:12px 0 14px;background:rgba(23,19,23,.98);backdrop-filter:blur(16px);border:1px solid var(--hair);list-style:none;margin:0;opacity:0;visibility:hidden;transform:translateY(-6px);transition:opacity .26s,transform .26s,visibility .26s}
.menu>li:hover .drop,.menu>li:focus-within .drop{opacity:1;visibility:visible;transform:translateY(0)}
.drop a{display:block;padding:9px 20px;font-family:var(--mono);font-size:.65rem;letter-spacing:.13em;text-transform:uppercase;color:var(--dust);transition:color .2s,background .2s}
.drop a:hover{color:var(--bone);background:rgba(237,229,218,.05)}
.burger{display:none;width:38px;height:30px;position:relative;z-index:95}
.burger span{position:absolute;left:5px;right:5px;height:1.3px;background:currentColor;transition:transform .32s}
.burger span:nth-child(1){top:10px}.burger span:nth-child(2){bottom:10px}
.burger.on span:nth-child(1){transform:translateY(4.5px) rotate(45deg)}
.burger.on span:nth-child(2){transform:translateY(-4.5px) rotate(-45deg)}
.panel{position:fixed;inset:0;z-index:90;background:var(--void);padding:100px var(--gut) 48px;overflow-y:auto;clip-path:inset(0 0 100% 0);transition:clip-path .5s cubic-bezier(.7,0,.2,1)}
.panel.open{clip-path:inset(0 0 0 0)}
.panel ul{list-style:none;margin:0;padding:0}
.panel>ul>li{border-bottom:1px solid var(--hair)}
.panel>ul>li>a,.acc-btn{display:flex;width:100%;justify-content:space-between;align-items:center;padding:20px 0;font-family:var(--serif);font-size:1.7rem;text-align:left}
.acc-sign{width:12px;height:12px;position:relative;flex:0 0 auto;opacity:.6}
.acc-sign::before,.acc-sign::after{content:"";position:absolute;background:currentColor}
.acc-sign::before{left:0;right:0;top:5.5px;height:1.2px}
.acc-sign::after{top:0;bottom:0;left:5.5px;width:1.2px;transition:transform .3s}
.acc-btn[aria-expanded="true"] .acc-sign::after{transform:scaleY(0)}
.acc-body{max-height:0;overflow:hidden;transition:max-height .42s cubic-bezier(.6,0,.2,1)}
.acc-body a{display:block;padding:11px 0 11px 16px;font-family:var(--mono);font-size:.72rem;letter-spacing:.13em;text-transform:uppercase;color:var(--dust)}
.acc-body li:last-child a{padding-bottom:22px}
@media (max-width:760px){ .menu{display:none} .burger{display:block} }
</style>

</body>
</html>
